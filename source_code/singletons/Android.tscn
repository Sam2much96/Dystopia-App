enabled = true

[connection signal="timeout" from="RainsTimer" to="." method="_on_RainsTimer_timeout"]
[connection signal="timeout" from="ScreenTimer" to="." method="_on_ScreenTimer_timeout"]
[connection signal="timeout" from="OrientationTimer" to="." method="_on_OrientationTimer_timeout"]
